rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── Admin authorization ─────────────────────────────────────────────
    //
    // Two paths are accepted, in this order:
    //
    //   1. Custom claims on the caller's Firebase Auth ID token:
    //      `admin: true`, `superAdmin: true`, or `role: 'admin'`.
    //      This is the "classic" path and the ONLY path that can authorize
    //      a list/query operation, because Firestore's query evaluation
    //      cannot use `get()`.
    //
    //   2. Firestore `users/{callerUid}.role === 'admin'`. This path uses
    //      `get()` and is therefore usable ONLY for single-document reads
    //      (allow get). It is retained for the app's Firestore-role
    //      admin flow on single-doc operations like
    //      `AdminRoute.verifyAdminServerSide`.
    //
    // Both paths must agree on the caller's identity; neither weakens the
    // other. A non-admin with Firestore `role: 'user'` and no claims still
    // fails both.
    //
    // NOTE: Firestore rules for `list` cannot call `get()`. Any match block
    // below that combines an admin path with a document-dependent self path
    // therefore splits `read` into `allow get` (which may use `get()`) and
    // `allow list` (which may not).
    // ────────────────────────────────────────────────────────────────────

    function hasAdminClaims() {
      return signedIn()
        && (request.auth.token.admin == true
            || request.auth.token.superAdmin == true
            || request.auth.token.role == 'admin');
    }

    function hasFirestoreAdminRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPrivilegedAdmin() {
      return signedIn()
        && (hasAdminClaims() || hasFirestoreAdminRole());
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Fields a signed-in user may write on their own /users/{uid} document.
    // Covers every legitimate self-write the client performs:
    //   - profile fields (edit form)
    //   - audit fields (login / logout / hydrate)
    //   - Auth-synced cache fields (provider link, phone verification,
    //     email change, email verification)
    //
    // Fields NOT listed here and therefore never writable by the user on
    // their own document:
    //   role           -- privilege escalation
    //   status         -- self-unsuspend
    //   subscription   -- billing integrity
    //   plan           -- billing integrity
    //   createdAt      -- immutable
    //   userId         -- identity
    //
    // Any change that touches one of those fields requires isPrivilegedAdmin().
    function isAllowedUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        // Profile fields (edit form)
        'displayName',
        'photoURL',
        'phone',
        'location',
        'bio',
        'title',
        'website',
        'github',
        'linkedin',
        'twitter',
        // Phone verification (written after Firebase Auth confirms the number)
        'phoneNumber',
        'phoneVerified',
        // Auth provider tracking (synced from the Firebase Auth SDK)
        'authProvider',
        'linkedProviders',
        // Audit fields (login / logout / hydrate)
        'lastLogin',
        'lastLogout',
        'lastActive',
        'updatedAt',
        'metadata',
        // Email cache (synced from Firebase Auth after updateEmail / verifyEmail)
        'email',
        'emailVerified'
      ]);
    }

    function isValidUserCreate() {
      return signedIn()
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && (!('subscription' in request.resource.data))
        && (!('plan' in request.resource.data))
        && (!('userId' in request.resource.data));
    }

    // ── users/{userId} ──────────────────────────────────────────────────
    // `read` is split into `get` and `list` because the admin path
    // (`isPrivilegedAdmin`) contains `get()` and therefore cannot be
    // evaluated for collection queries. Admin collection reads require
    // `hasAdminClaims()`.
    match /users/{userId} {
      allow get: if isSelf(userId) || isPrivilegedAdmin();
      allow list: if hasAdminClaims();
      allow create: if isSelf(userId) && isValidUserCreate();
      allow update: if (isSelf(userId) && isAllowedUserUpdate()) || isPrivilegedAdmin();
      allow delete: if isSelf(userId) || isPrivilegedAdmin();
    }

    // Fields a signed-in user may write on their own /resumes/{resumeId}
    // document. Must stay aligned with `ALLOWED_RESUME_UPDATE_FIELDS` in
    // `src/services/resumeService.js`.
    //
    // Fields NOT listed here are silently rejected at the rules layer if a
    // client tries to include them:
    //   userId     -- ownership; must never change
    //   createdAt  -- immutable creation timestamp
    //   id         -- document id, not a data field
    //
    // `updatedAt` is written by every updateResume / autoSaveResume /
    // incrementViewCount / incrementDownloadCount call. `archivedAt` is
    // written by archiveResume. Both are self-managed bookkeeping fields
    // on the user's own document and must be permitted.
    function isAllowedResumeUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'data',
        'template',
        'name',
        'status',
        'atsScore',
        'downloadCount',
        'viewCount',
        'lastDownloaded',
        'lastViewed',
        'archivedAt',
        'updatedAt'
      ]);
    }

    // ── resumes/{resumeId} ──────────────────────────────────────────────
    // `read` is split into `get` and `list`. The user path
    // (`resource.data.userId == request.auth.uid`) is query-provable
    // because the client filters the list by `userId`. The admin path
    // for lists requires `hasAdminClaims()`.
    match /resumes/{resumeId} {
      allow get: if signedIn()
        && (resource.data.userId == request.auth.uid || isPrivilegedAdmin());

      allow list: if signedIn()
        && (resource.data.userId == request.auth.uid || hasAdminClaims());

      // Direct client-side resume creation is denied.
      // The Netlify Functions use Admin SDK, which bypasses these rules.
      allow create: if isPrivilegedAdmin();

      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || isPrivilegedAdmin())
        && (isPrivilegedAdmin() || isAllowedResumeUpdate());

      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isPrivilegedAdmin());
    }

    match /settings/{userId} {
      allow read, write: if isSelf(userId);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /templates/{templateId} {
      allow read: if true;
    }

    // ── subscriptions/{userId} ──────────────────────────────────────────
    // Same split as `users/{userId}` — the admin path contains `get()`,
    // so admin list operations require `hasAdminClaims()`.
    match /subscriptions/{userId} {
      allow get: if isSelf(userId) || isPrivilegedAdmin();
      allow list: if hasAdminClaims();
      allow create, update: if isPrivilegedAdmin();
      allow delete: if isSelf(userId) || isPrivilegedAdmin();
    }

    // ── analytics/{docId} ───────────────────────────────────────────────
    // Same split as above.
    match /analytics/{docId} {
      allow get: if isPrivilegedAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow list: if hasAdminClaims()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId', 'name'])
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isPrivilegedAdmin();
    }

    match /users/{userId}/sessions/{sessionId} {
      allow read, create, update, delete: if isSelf(userId);
    }

    // ── deletedAccounts/{docId} ─────────────────────────────────────────
    // Admin-only. `read` is split; list operations require claims.
    match /deletedAccounts/{docId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow get, update, delete: if isPrivilegedAdmin();
      allow list: if hasAdminClaims();
    }
  }
}